---
import Layout from "../../layouts/Layout.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";

// SEO & Meta variables
const title =
  "Driving India's Electric Future, One Conversation at a Time - SunArth";
const description =
  "Discover SunArth's vision and engineering innovations showcased at Prawaas 5.0. Shaping the future of EV mobility and infrastructure.";
const canonicalURL = "https://sunarth.com/events/prawaas-2026";
const ogImage = "/prawas.png"; 

const post = {
  title: "",
  category: "Events",
  date: "22 July 2026",
  readTime: "6 min",
  author: "SunArth Team",
};
---

<Layout
  title={title}
  description={description}
  image={ogImage}
  publishedAt="2026-07-22"
>
  <!-- Scroll Progress Bar -->
  <div class="scroll-progress-container">
    <div class="scroll-progress-bar" id="progressBar"></div>
  </div>

  <main>
    <!-- 1. Fullscreen Hero with pw3.webp Image Background -->
    <section class="hero" aria-label="Hero Section">
      <img src="/pw3.webp" alt="SunArth at Prawaas 5.0" class="hero-bg-img" />
      <div class="hero-overlay"></div>

      <div class="hero-content reveal">
        <span class="hero-category">{post.category}</span>
        <h1 class="hero-title">{post.title}</h1>
        <div class="hero-meta">
          <span>{post.author}</span>
          <span class="dot">•</span>
          <span>{post.date}</span>
          <span class="dot">•</span>
          <span>{post.readTime}</span>
        </div>
      </div>

      <div class="scroll-indicator" aria-hidden="true">
        <div class="mouse">
          <div class="wheel"></div>
        </div>
      </div>
    </section>

    <!-- 2. Editorial Introduction -->
    <section class="editorial-intro reveal" aria-label="Introduction">
      <div class="container narrow">
        <p class="drop-cap lead">
          The shift toward a smarter, safer, and cleaner public transport
          ecosystem is moving faster than ever. Between July 9th and 11th, 2026,
          the heart of this transformation was beating at the Helipad Exhibition
          Centre in Gandhinagar, Gujarat, during Prawaas 5.0.
        </p>
        <p>
          As one of India’s premier Safe, Smart, and Sustainable Transport
          Expos, Prawaas brings together policymakers, industry leaders, and
          innovators. We were present not just to showcase hardware, but to
          participate in a profound dialogue about the architecture of
          sustainable transit.
        </p>
      </div>
    </section>

    <!-- 3. Full Width Image -->
    <section class="full-width-image reveal" aria-label="Booth Overview">
      <div class="container">
        <figure>
          <div class="image-wrapper">
            <img
              src="/pw1.webp"
              alt="Wide shot of the SunArth exhibition booth at Prawaas"
              loading="lazy"
            />
          </div>
          <figcaption>
            The SunArth exhibition space, designed for transparency and
            engagement.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- 4. Story Section -->
    <section class="story-section reveal" aria-label="Story">
      <div class="container narrow text-center">
        <h2 class="section-heading">More Than an Exhibition</h2>
        <p class="story-text">
          Building EV infrastructure is not merely about deploying chargers. It
          is about engineering absolute reliability into the very fabric of
          tomorrow's mobility. At our booth, the energy was palpable. We engaged
          directly with fleet operators, public transport stakeholders, and
          technology enthusiasts who share a singular vision: a world where
          range anxiety is a relic of the past.
        </p>
        <p class="story-text">
          Every wire, every node, and every software interface we design is
          crafted to eliminate friction. We believe that the transition to
          electric mobility must be seamless, scalable, and inherently beautiful
          in its efficiency.
        </p>
      </div>
    </section>

    <!-- 5. Split Section -->
    <section class="split-section reveal" aria-label="Technology Details">
      <div class="container grid-split">
        <div class="split-image">
          <div class="image-wrapper parallax-wrapper">
            <img
              src="/pr1.webp"
              alt="Close up of SunArth EV charging technology"
              loading="lazy"
            />
          </div>
        </div>
        <div class="split-text">
          <h2 class="section-heading">Engineered for Scale</h2>
          <p>
            Our hardware meets the rigorous demands of commercial fleets and
            passenger transport. From high-speed charging nodes to intelligent
            energy management systems, we demonstrate how profound engineering
            can maximize operational uptime.
          </p>
          <p>
            Seamless scalability and robust physical design converge to create
            an ecosystem that operators can trust implicitly. This is
            infrastructure built not just for today, but for the next decade of
            transport evolution.
          </p>
        </div>
      </div>
    </section>

    <!-- 6. Statistics -->
    <section class="statistics-section reveal" aria-label="Event Statistics">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card glass">
            <span class="stat-number">220+</span>
            <span class="stat-label">Exhibitors</span>
          </div>
          <div class="stat-card glass">
            <span class="stat-number">20,000+</span>
            <span class="stat-label">Visitors</span>
          </div>
          <div class="stat-card glass">
            <span class="stat-number">3</span>
            <span class="stat-label">Days</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. Large Editorial Quote -->
    <section class="quote-section reveal" aria-label="Featured Quote">
      <div class="container narrow text-center">
        <blockquote class="editorial-quote">
          <span class="quote-mark">“</span>
          Reliable charging creates reliable transportation.
          <span class="quote-mark">”</span>
        </blockquote>
      </div>
    </section>

    <!-- 8. Masonry Gallery -->
    <section class="gallery-section reveal" aria-label="Image Gallery">
      <div class="container">
        <div class="masonry-grid">
          <div class="gallery-item item-large">
            <img
              src="/pr2.webp"
              alt="SunArth technology showcase"
              loading="lazy"
            />
          </div>
          <div class="gallery-item item-small">
            <img
              src="/pw1.webp"
              alt="Exhibition floor interactions"
              loading="lazy"
            />
          </div>
          <div class="gallery-item item-small">
            <img
              src="/pr1.webp"
              alt="Detailed view of engineering components"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- 9. Timeline -->
    <section class="timeline-section reveal" aria-label="Event Timeline">
      <div class="container narrow">
        <h2 class="section-heading text-center">The Journey</h2>
        <div class="timeline">
          <div class="timeline-item">
            <div class="time-date">9 July</div>
            <div class="time-content">
              <h3>Opening</h3>
              <p>
                Inaugurating the vision for a sustainable future alongside
                policymakers.
              </p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="time-date">10 July</div>
            <div class="time-content">
              <h3>Technology Showcase</h3>
              <p>
                Demonstrating our intelligent energy management systems to fleet
                operators.
              </p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="time-date">11 July</div>
            <div class="time-content">
              <h3>Networking & Collaboration</h3>
              <p>
                Forging the partnerships that will scale India's EV
                infrastructure.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 10. Looking Ahead -->
    <section class="looking-ahead reveal" aria-label="Conclusion">
      <div class="container narrow text-center">
        <h2 class="section-heading">Looking Ahead</h2>
        <p class="story-text">
          Connecting with thousands of participants reminded us of the sheer
          scale of India's mobility revolution. The insights we gathered at
          Prawaas 5.0 are already feeding back into our product development
          cycle, shaping the next generation of SunArth engineering. The road
          ahead is electric, and we are laying the foundation.
        </p>
      </div>
    </section>

    <!-- 11. CTA -->
    <section class="cta-section reveal" aria-label="Call to Action">
      <div class="cta-bg-glow"></div>
      <div class="container text-center cta-content">
        <h2 class="cta-heading">Ready to electrify your fleet?</h2>
        <p class="cta-sub">
          Discover how our smart EV charging solutions can accelerate your
          journey.
        </p>
        <a href="/contact" class="btn-primary">Contact Us</a>
      </div>
    </section>

    <!-- 12. Related Articles (Horizontal Scroll Insight Cards) -->
    <RelatedArticles currentSlug="prawas" />
  </main>

  <style>
    /* ==========================================================================
       Design System & Variables
       ========================================================================== */
    :root {
      /* Colors */
      --bg-primary: #ffffff;
      --bg-secondary: #f4f8f5;
      --text-primary: #10231c;
      --text-secondary: #61716a;
      --text-hero: #f5fff8;
      --accent: #087947;
      --dark-section: #10251c;

      /* Typography */
      --font-sans: "Inter", sans-serif;
      --font-serif: "Manrope", sans-serif;

      /* Spacing */
      --space-xs: 0.5rem;
      --space-sm: 1rem;
      --space-md: 1.5rem;
      --space-lg: 3rem;
      --space-xl: 5rem;
      --space-xxl: 7rem;

      /* Easing */
      --ease-apple: cubic-bezier(0.25, 1, 0.5, 1);
      --transition-slow: 0.8s var(--ease-apple);
      --transition-med: 0.4s var(--ease-apple);
    }

    /* ==========================================================================
       Reset & Base
       ========================================================================== */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-primary);
      color: var(--text-primary);
      line-height: 1.5;
      overflow-x: hidden;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    /* ==========================================================================
       Layout Utilities
       ========================================================================== */
    .container {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .container.narrow {
      max-width: 800px;
    }

    .text-center {
      text-align: center;
    }

    /* ==========================================================================
       Typography
       ========================================================================== */
    .section-heading {
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 600;
      letter-spacing: -0.02em;
      line-height: 1.1;
      margin-bottom: var(--space-lg);
    }

    p {
      font-size: clamp(1.125rem, 2vw, 1.35rem);
      line-height: 1.6;
      color: var(--text-secondary);
      margin-bottom: var(--space-md);
      font-weight: 400;
    }

    p:last-child {
      margin-bottom: 0;
    }

    /* ==========================================================================
       Scroll Progress
       ========================================================================== */
    .scroll-progress-container {
      position: fixed;
      top: 64px;
      left: 0;
      width: 100%;
      height: 2px;
      background: transparent;
      z-index: 999;
    }

    .scroll-progress-bar {
      height: 100%;
      background: var(--accent);
      width: 0%;
      transition: width 0.1s ease-out;
    }

    /* ==========================================================================
       Animations (Intersection Observer)
       ========================================================================== */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition:
        opacity 1s var(--ease-apple),
        transform 1s var(--ease-apple);
      will-change: opacity, transform;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* ==========================================================================
       1. Hero Section with pw3.webp Background
       ========================================================================== */
    .hero {
      position: relative;
      height: 100vh;
      min-height: 600px;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-bottom: 25vh;
      overflow: hidden;
      background: #000;
    }

    .hero-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
    }

    .hero-overlay {
      position: absolute;
      inset: 0;
      z-index: 2;
    }

    .hero-content {
      position: relative;
      z-index: 3;
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 2rem;
      text-align: center;
      color: var(--text-hero);
    }

    .hero-category {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      margin-bottom: var(--space-sm);
      color: rgba(255, 255, 255, 0.85);
    }

    .hero-title {
      font-size: clamp(2.5rem, 6vw, 5.5rem);
      font-weight: 700;
      letter-spacing: -0.03em;
      line-height: 1.05;
      margin-bottom: var(--space-md);
      text-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .hero-meta {
      font-size: 1rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.85);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
    }

    .dot {
      font-size: 0.5rem;
      opacity: 0.5;
    }

    .scroll-indicator {
      position: absolute;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 3;
    }

    .mouse {
      width: 26px;
      height: 42px;
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-radius: 13px;
      position: relative;
    }

    .wheel {
      width: 4px;
      height: 8px;
      background: #fff;
      border-radius: 2px;
      position: absolute;
      top: 6px;
      left: 50%;
      transform: translateX(-50%);
      animation: scrollWheel 2s infinite var(--ease-apple);
    }

    @keyframes scrollWheel {
      0% {
        transform: translate(-50%, 0);
        opacity: 1;
      }
      100% {
        transform: translate(-50%, 15px);
        opacity: 0;
      }
    }

    /* ==========================================================================
       2. Editorial Introduction
       ========================================================================== */
    .editorial-intro {
      padding: var(--space-xxl) 0 var(--space-xl) 0;
      background: var(--bg-primary);
    }

    .drop-cap::first-letter {
      float: left;
      font-size: 5.5rem;
      line-height: 0.8;
      font-weight: 700;
      margin-right: 0.15em;
      color: var(--text-primary);
      font-family: var(--font-serif);
    }

    .lead {
      color: var(--text-primary);
      font-size: clamp(1.3rem, 2.5vw, 1.75rem);
      font-weight: 400;
      line-height: 1.5;
    }

    /* ==========================================================================
       3. Full Width Image
       ========================================================================== */
    .full-width-image {
      padding: 0 0 var(--space-xl) 0;
    }

    .image-wrapper {
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
      transform: translateZ(0);
    }

    .image-wrapper img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1.5s var(--ease-apple);
    }

    .image-wrapper:hover img {
      transform: scale(1.03);
    }

    figcaption {
      margin-top: 1rem;
      text-align: center;
      font-size: 0.9rem;
      color: var(--text-secondary);
      font-weight: 500;
    }

    /* ==========================================================================
       4. Story Section
       ========================================================================== */
    .story-section {
      padding: var(--space-xl) 0;
      background: var(--bg-secondary);
    }

    .story-text {
      color: var(--text-primary);
    }

    /* ==========================================================================
       5. Split Section
       ========================================================================== */
    .split-section {
      padding: var(--space-xl) 0;
    }

    .grid-split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-lg);
      align-items: center;
    }

    .parallax-wrapper {
      height: 500px;
    }

    .split-text h2 {
      margin-bottom: var(--space-md);
    }

    @media (max-width: 900px) {
      .grid-split {
        grid-template-columns: 1fr;
      }
      .parallax-wrapper {
        height: 350px;
      }
    }

    /* ==========================================================================
       6. Statistics
       ========================================================================== */
    .statistics-section {
      padding: var(--space-xl) 0;
      background: var(--bg-secondary);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .stat-card {
      padding: 3rem 1.5rem;
      text-align: center;
      border-radius: 24px;
      background: rgba(255, 255, 255, 0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.5);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      transition: transform var(--transition-med);
    }

    .stat-card:hover {
      transform: translateY(-10px);
    }

    .stat-number {
      display: block;
      font-size: 3.5rem;
      font-weight: 700;
      letter-spacing: -0.04em;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      background: linear-gradient(135deg, #1d1d1f 0%, #434343 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .stat-label {
      font-size: 1.125rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* ==========================================================================
       7. Large Editorial Quote
       ========================================================================== */
    .quote-section {
      padding: var(--space-xl) 0;
    }

    .editorial-quote {
      position: relative;
      font-size: clamp(2rem, 5vw, 4rem);
      font-family: var(--font-serif);
      font-weight: 500;
      line-height: 1.2;
      color: var(--text-primary);
      margin: 0;
    }

    .quote-mark {
      font-size: 1.5em;
      color: rgba(0, 0, 0, 0.1);
      line-height: 0;
      vertical-align: -0.2em;
      font-family: var(--font-sans);
    }

    /* ==========================================================================
       8. Masonry Gallery
       ========================================================================== */
    .gallery-section {
      padding: 0 0 var(--space-xl) 0;
    }

    .masonry-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }

    .gallery-item {
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06);
    }

    .gallery-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 1s var(--ease-apple);
    }

    .gallery-item:hover img {
      transform: scale(1.05);
    }

    .item-large {
      grid-column: 1 / -1;
      height: 500px;
    }

    .item-small {
      height: 350px;
    }

    @media (max-width: 768px) {
      .masonry-grid {
        grid-template-columns: 1fr;
      }
      .item-large,
      .item-small {
        height: 300px;
      }
    }

    /* ==========================================================================
       9. Timeline
       ========================================================================== */
    .timeline-section {
      padding: var(--space-xl) 0;
      background: var(--bg-secondary);
    }

    .timeline {
      position: relative;
      margin-top: 3rem;
    }

    .timeline::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 2px;
      background: rgba(0, 0, 0, 0.1);
      transform: translateX(-50%);
    }

    .timeline-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2.5rem;
      position: relative;
      width: 100%;
    }

    .timeline-item::after {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      background: var(--bg-primary);
      border: 3px solid var(--text-primary);
      border-radius: 50%;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 2;
      transition: transform 0.3s;
    }

    .timeline-item:hover::after {
      transform: translate(-50%, -50%) scale(1.3);
      border-color: var(--accent);
    }

    .time-date {
      width: 45%;
      text-align: right;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      padding-right: 3rem;
    }

    .time-content {
      width: 45%;
      padding-left: 3rem;
    }

    .time-content h3 {
      font-size: 1.25rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .time-content p {
      font-size: 1rem;
      margin: 0;
    }

    .timeline-item:nth-child(even) {
      flex-direction: row-reverse;
    }

    .timeline-item:nth-child(even) .time-date {
      text-align: left;
      padding-right: 0;
      padding-left: 3rem;
    }

    .timeline-item:nth-child(even) .time-content {
      text-align: right;
      padding-left: 0;
      padding-right: 3rem;
    }

    @media (max-width: 768px) {
      .timeline::before {
        left: 20px;
      }
      .timeline-item,
      .timeline-item:nth-child(even) {
        flex-direction: column;
        align-items: flex-start;
      }
      .timeline-item::after {
        left: 20px;
        top: 24px;
      }
      .time-date,
      .time-content,
      .timeline-item:nth-child(even) .time-date,
      .timeline-item:nth-child(even) .time-content {
        width: 100%;
        text-align: left;
        padding-left: 60px;
        padding-right: 0;
      }
      .time-date {
        margin-bottom: 0.5rem;
      }
    }

    /* ==========================================================================
       10. Looking Ahead
       ========================================================================== */
    .looking-ahead {
      padding: var(--space-xl) 0 var(--space-xxl) 0;
    }

    /* ==========================================================================
       11. CTA Section
       ========================================================================== */
    .cta-section {
      position: relative;
      background: var(--dark-section);
      color: white;
      padding: var(--space-xxl) 0;
      overflow: hidden;
    }

    .cta-bg-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 600px;
      height: 600px;
      background: radial-gradient(
        circle,
        rgba(0, 113, 227, 0.3) 0%,
        rgba(0, 0, 0, 0) 70%
      );
      transform: translate(-50%, -50%);
      z-index: 1;
      animation: pulseGlow 4s infinite alternate;
    }

    @keyframes pulseGlow {
      0% {
        opacity: 0.5;
        transform: translate(-50%, -50%) scale(1);
      }
      100% {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1.1);
      }
    }

    .cta-content {
      position: relative;
      z-index: 2;
    }

    .cta-heading {
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 700;
      letter-spacing: -0.02em;
      margin-bottom: 1rem;
    }

    .cta-sub {
      color: #a1a1a6;
      margin-bottom: 3rem;
    }

    .btn-primary {
      display: inline-block;
      background: white;
      color: black;
      font-weight: 600;
      font-size: 1.125rem;
      padding: 1.25rem 3rem;
      border-radius: 40px;
      transition: all 0.3s var(--ease-apple);
    }

    .btn-primary:hover {
      transform: scale(1.05);
      box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
    }
  </style>

  <script>
    // Scroll Progress Bar
    window.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const bar = document.getElementById("progressBar");
      if (bar) bar.style.width = scrolled + "%";
    });

    // Intersection Observer for fade-up animations
    const observerOptions = {
      root: null,
      rootMargin: "0px 0px -100px 0px",
      threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("active");
        }
      });
    }, observerOptions);

    document.addEventListener("DOMContentLoaded", () => {
      const revealElements = document.querySelectorAll(".reveal");
      revealElements.forEach((el) => observer.observe(el));
    });
  </script>
</Layout>
