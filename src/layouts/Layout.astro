---
export interface Props {
  title: string;
  description?: string;
  image?: string;
  publishedAt?: string;
}

const {
  title,
  description = "Expert guides, industry insights, and charging infrastructure resources engineered for the future by SunArth.",
  image = "/img1.svg",
  publishedAt,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url,
).toString();
const isArticle = Astro.url.pathname.startsWith("/blog/");
const structuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title.replace(" | SunArth Insights", ""),
      description,
      image: new URL(image, Astro.site ?? Astro.url).toString(),
      url: canonical,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
      author: { "@type": "Organization", name: "SunArth" },
      publisher: {
        "@type": "Organization",
        name: "SunArth",
        logo: {
          "@type": "ImageObject",
          url: new URL(
            "/sunarth-logo.webp",
            Astro.site ?? Astro.url,
          ).toString(),
        },
      },
      ...(publishedAt
        ? { datePublished: publishedAt, dateModified: publishedAt }
        : {}),
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "SunArth Insights",
      url: canonical,
      publisher: { "@type": "Organization", name: "SunArth" },
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/webicon2.webp" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href="/" aria-label="SunArth Insights home">
          <img
            src="/sunarth-logo.webp"
            alt="SunArth — Delivering Green Solutions"
          />
        </a>

        <button
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          <span class="sr-only">Open navigation</span>
          <span></span><span></span><span></span>
        </button>

        <nav
          class="primary-nav"
          id="primary-navigation"
          aria-label="Primary navigation"
        >
          <a href="/">Insights</a>
          <a href="https://sunarth.com/hardware">EV Chargers</a>
          <a href="https://sunarth.com/about">About SunArth</a>
          <a class="nav-cta" href="https://sunarth.com/contact"
            >Talk to an expert <span aria-hidden="true">→</span></a
          >
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="footer-shell">
        <div class="footer-intro">
          <a
            class="brand footer-brand"
            href="/"
            aria-label="SunArth Insights home"
          >
            <img
              src="/sunarth-logo.webp"
              alt="SunArth — Delivering Green Solutions"
            />
          </a>
          <p>
            Practical EV charging intelligence for India’s businesses, fleets,
            and communities.
          </p>
          <a class="footer-contact" href="mailto:info@sunarth.com"
            >info@sunarth.com <span aria-hidden="true">↗</span></a
          >
        </div>

        <div class="footer-links">
          <div>
            <h2>Explore</h2>
            <a href="/">Latest insights</a>
            <a href="/blog/ev-charging-guide">EV charging guide</a>
            <a href="/blog/commercial-hubs">Commercial charging</a>
            <a href="/blog/ac-vs-dc">AC vs DC charging</a>
          </div>
          <div>
            <h2>SunArth</h2>
            <a href="https://sunarth.com/hardware">Our chargers</a>
            <a href="https://sunarth.com/about">About us</a>
            <a href="https://sunarth.com/contact">Contact</a>
            <a href="https://sunarth.com/privacy-policy">Privacy policy</a>
          </div>
        </div>
      </div>
      <div class="footer-base">
        <p>© {new Date().getFullYear()} SunArth. All rights reserved.</p>
        <p>Built for India’s electric future.</p>
      </div>
    </footer>

    <script is:inline>
      const toggle = document.querySelector(".menu-toggle");
      const navigation = document.querySelector(".primary-nav");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        navigation?.classList.toggle("is-open", !open);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --primary: #087947;
    --primary-dark: #045f38;
    --ink: #10231c;
    --muted: #61716a;
    --surface: #f7f9f7;
    --line: #dfe7e2;
    --white: #fff;
    --text-main: var(--ink);
    --text-light: var(--muted);
    --bg-color: var(--surface);
    --border: var(--line);
    --accent: #087947;
  }
  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    margin: 0;
    min-width: 320px;
    font-family: "Inter", sans-serif;
    color: var(--ink);
    background: var(--surface);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Manrope", sans-serif;
    color: var(--ink);
    line-height: 1.2;
  }
  a {
    color: inherit;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid rgba(223, 231, 226, 0.9);
    backdrop-filter: blur(16px);
  }
  .nav-shell {
    width: min(1240px, calc(100% - 40px));
    min-height: 76px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--ink);
    text-decoration: none;
  }
  .brand img {
    display: block;
    width: 148px;
    height: 46px;
    object-fit: cover;
    object-position: center;
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .primary-nav > a {
    color: #42544c;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .primary-nav > a:not(.nav-cta):hover {
    color: var(--primary);
  }
  .nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 15px;
    border-radius: 8px;
    background: var(--primary);
    color: #fff !important;
    box-shadow: 0 5px 14px rgba(8, 121, 71, 0.16);
  }
  .nav-cta:hover {
    background: var(--primary-dark);
  }
  .menu-toggle {
    display: none;
    padding: 8px 2px;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .menu-toggle span:not(.sr-only) {
    display: block;
    width: 23px;
    height: 2px;
    margin: 4px;
    background: var(--ink);
  }
  .site-footer {
    margin-top: 72px;
    background: #10251c;
    color: #d5e1da;
  }
  .footer-shell {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
    padding: 64px 0 52px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
  }
  .footer-brand {
    margin-bottom: 20px;
  }
  .footer-brand img {
    width: 175px;
    height: 55px;
    border-radius: 3px;
  }
  .footer-intro p {
    max-width: 400px;
    margin: 0 0 24px;
    color: #a9bbb1;
    font-size: 0.95rem;
  }
  .footer-contact {
    color: #fff;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }
  .footer-contact span {
    color: #8fd3ac;
    margin-left: 5px;
  }
  .footer-contact:hover {
    color: #8fd3ac;
  }
  .footer-links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }
  .footer-links h2 {
    margin: 0 0 18px;
    color: #fff;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer-links a {
    display: block;
    width: fit-content;
    margin: 0 0 11px;
    color: #a9bbb1;
    font-size: 0.9rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .footer-links a:hover {
    color: #fff;
  }
  .footer-base {
    width: min(1240px, calc(100% - 40px));
    margin: 0 auto;
    padding: 19px 0 22px;
    border-top: 1px solid rgba(213, 225, 218, 0.16);
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: #8ba196;
    font-size: 0.78rem;
  }
  .footer-base p {
    margin: 0;
  }
  @media (max-width: 720px) {
    .nav-shell {
      min-height: 67px;
    }
    .menu-toggle {
      display: block;
    }
    .primary-nav {
      position: absolute;
      inset: 67px 0 auto;
      display: none;
      padding: 12px 20px 20px;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: 0 12px 20px rgba(16, 35, 28, 0.08);
    }
    .primary-nav.is-open {
      display: grid;
      gap: 5px;
    }
    .primary-nav > a {
      padding: 10px 0;
    }
    .nav-cta {
      justify-content: center;
      margin-top: 8px;
    }
    .footer-shell {
      grid-template-columns: 1fr;
      gap: 42px;
      padding: 48px 0 38px;
    }
    .footer-base {
      flex-direction: column;
    }
    .footer-links {
      gap: 22px;
    }
  }
</style>
