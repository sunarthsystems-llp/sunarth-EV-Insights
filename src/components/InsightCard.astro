---
export interface Props {
  title: string;
  url: string;
  image: string;
  altText: string;
  tag: string;
  description: string;
}

const { title, url, image, altText, tag, description } = Astro.props;
---

<a href={url} class="article-card">
  <img src={image} alt={altText} class="card-img" />
  <div class="card-body">
    <span class="tag">{tag}</span>
    <h4>{title}</h4>
    <p>{description}</p>
    <span class="read-more">Read &rarr;</span>
  </div>
</a>

<style>
  .article-card {
    /* Horizontal scroll sizing and snapping */
    flex: 0 0 350px;
    scroll-snap-align: start;
    background: var(--white, #ffffff);
    border-radius: 12px;
    border: 1px solid var(--border, #e2e8f0);
    overflow: hidden;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  .article-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.05);
  }

  .card-img {
    height: 220px;
    width: 100%;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--border, #e2e8f0);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }
  .flex-grow {
    -grow: 1;
  }
  .tag {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary, #0e7a4d);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .card-body h4 {
    font-family: "Manrope", sans-serif;
    font-size: 1.3rem;
    margin: 0.5rem 0 1rem;
    line-height: 1.4;
    color: var(--text-main, #10231c);
  }

  .card-body p {
    color: var(--text-light, #61716a);
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
    grow: 1;
  }

  .read-more {
    font-weight: 600;
    color: var(--text-main, #10231c);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .article-card:hover .read-more {
    color: var(--primary, #0e7a4d);
  }

  /* Responsive sizing for mobile screens */
  @media (max-width: 768px) {
    .article-card {
      flex: 0 0 280px;
    }
  }
</style>
